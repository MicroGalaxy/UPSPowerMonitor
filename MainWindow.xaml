<Window x:Class="UPSPowerMonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="UPS 电源监控"
        Width="1000"
        Height="680"
        MinWidth="880"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Icon="Assets/app-icon.ico"
        Background="#F4F7FB">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="224" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#0F172A">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Margin="28,30,20,28">
                    <Image Width="48" Height="48" HorizontalAlignment="Left" Source="Assets/app-icon.png" Stretch="Uniform" />
                    <TextBlock Margin="0,14,0,0" Text="UPS Monitor" Foreground="White" FontSize="19" FontWeight="Bold" />
                    <TextBlock Margin="0,4,0,0" Text="电源状态与远程告警" Foreground="#64748B" FontSize="12" />
                </StackPanel>

                <StackPanel Grid.Row="1">
                    <RadioButton Content="概览"
                                 GroupName="Navigation"
                                 IsChecked="{Binding IsDashboardSelected, Mode=OneWay}"
                                 Command="{Binding NavigateCommand}"
                                 CommandParameter="Dashboard"
                                 Style="{StaticResource NavigationButtonStyle}" />
                    <RadioButton Content="通知设置"
                                 GroupName="Navigation"
                                 IsChecked="{Binding IsSettingsSelected, Mode=OneWay}"
                                 Command="{Binding NavigateCommand}"
                                 CommandParameter="Settings"
                                 Style="{StaticResource NavigationButtonStyle}" />
                </StackPanel>

                <Border Grid.Row="3" Margin="20,20,20,24" Padding="13" Background="#162033" CornerRadius="9">
                    <StackPanel>
                        <TextBlock Text="当前设备" Foreground="#64748B" FontSize="11" />
                        <TextBlock Margin="0,5,0,0" Text="{Binding MachineName}" Foreground="#CBD5E1" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid Visibility="{Binding IsDashboardSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="38,32,38,36">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="28" />
                            <RowDefinition Height="230" />
                            <RowDefinition Height="22" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <StackPanel>
                                <TextBlock Text="电源概览" Foreground="#0F172A" FontSize="27" FontWeight="Bold" />
                                <TextBlock Margin="0,7,0,0" Text="实时监控服务器市电和 UPS 电池状态" Foreground="#64748B" FontSize="13" />
                            </StackPanel>
                            <Border HorizontalAlignment="Right" VerticalAlignment="Top" Padding="12,7" Background="#DCFCE7" CornerRadius="16">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="7" Height="7" Margin="0,0,7,0" Fill="#16A34A" />
                                    <TextBlock Text="监控运行中" Foreground="#15803D" FontSize="12" FontWeight="SemiBold" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*" />
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="2*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="{Binding PowerCardBackground}" CornerRadius="16" Padding="28">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="18" Direction="270" ShadowDepth="3" Color="#CBD5E1" Opacity="0.35" />
                                </Border.Effect>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="当前供电" Foreground="#64748B" FontSize="13" FontWeight="SemiBold" />
                                    <StackPanel Grid.Row="1" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="14" Height="14" Margin="0,5,12,0" VerticalAlignment="Top" Fill="{Binding PowerAccentBrush}" />
                                            <TextBlock Text="{Binding PowerStatusText}" Foreground="{Binding PowerAccentBrush}" FontSize="31" FontWeight="Bold" />
                                        </StackPanel>
                                        <TextBlock Margin="26,10,0,0" Text="{Binding PowerDescription}" Foreground="#475569" FontSize="14" />
                                    </StackPanel>
                                    <TextBlock Grid.Row="2" Text="{Binding LastUpdatedText}" Foreground="#94A3B8" FontSize="11" />
                                </Grid>
                            </Border>

                            <Border Grid.Column="2" Background="White" CornerRadius="16" Padding="25">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="18" Direction="270" ShadowDepth="3" Color="#CBD5E1" Opacity="0.35" />
                                </Border.Effect>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="电池容量" Foreground="#64748B" FontSize="13" FontWeight="SemiBold" />
                                    <TextBlock Grid.Row="1" Text="{Binding BatteryText}" VerticalAlignment="Center" Foreground="#0F172A" FontSize="40" FontWeight="Bold" />
                                    <ProgressBar Grid.Row="2" Height="8" Margin="0,0,0,13" Maximum="100" Value="{Binding BatteryPercentage, Mode=OneWay}" Foreground="#2563EB" Background="#E2E8F0" BorderThickness="0" />
                                    <TextBlock Grid.Row="3" Text="{Binding BatteryDescription}" Foreground="#64748B" FontSize="12" TextWrapping="Wrap" />
                                </Grid>
                            </Border>
                        </Grid>

                        <Border Grid.Row="4" Background="White" CornerRadius="16" Padding="26,22">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="2" Color="#CBD5E1" Opacity="0.3" />
                            </Border.Effect>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="1" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,25,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="9" Height="9" Margin="0,1,9,0" Fill="#2563EB" />
                                        <TextBlock Text="最近推送" Foreground="#334155" FontSize="13" FontWeight="SemiBold" />
                                    </StackPanel>
                                    <TextBlock Margin="18,10,0,0" Text="{Binding LastNotificationText}" Foreground="#64748B" FontSize="12" TextWrapping="Wrap" />
                                </StackPanel>
                                <Border Grid.Column="1" Background="#E2E8F0" />
                                <StackPanel Grid.Column="2" Margin="25,0,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="9" Height="9" Margin="0,1,9,0">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="#F59E0B" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasBarkConfiguration}" Value="True">
                                                            <Setter Property="Fill" Value="#16A34A" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <TextBlock Text="Bark 通知" Foreground="#334155" FontSize="13" FontWeight="SemiBold" />
                                    </StackPanel>
                                    <TextBlock Margin="18,10,0,0" Foreground="#64748B" FontSize="12">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="尚未配置推送 ID" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasBarkConfiguration}" Value="True">
                                                        <Setter Property="Text" Value="配置已就绪" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </Grid>

            <Grid Visibility="{Binding IsSettingsSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="38,32,38,36">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="25" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel>
                            <TextBlock Text="通知设置" Foreground="#0F172A" FontSize="27" FontWeight="Bold" />
                            <TextBlock Margin="0,7,0,0" Text="配置 Bark 接收设备和告警方式" Foreground="#64748B" FontSize="13" />
                        </StackPanel>

                        <Border Grid.Row="2" Background="White" CornerRadius="16" Padding="30">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="18" Direction="270" ShadowDepth="3" Color="#CBD5E1" Opacity="0.32" />
                            </Border.Effect>
                            <StackPanel>
                                <TextBlock Text="Bark 推送 ID" Foreground="#1E293B" FontSize="14" FontWeight="SemiBold" />
                                <TextBlock Margin="0,6,0,10" Text="支持多个 ID，每行一个，也可使用逗号或分号分隔。" Foreground="#94A3B8" FontSize="12" />
                                <TextBox MinHeight="90"
                                         Text="{Binding BarkIdsText, UpdateSourceTrigger=PropertyChanged}"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         VerticalContentAlignment="Top"
                                         Style="{StaticResource InputTextBoxStyle}" />

                                <TextBlock Margin="0,24,0,8" Text="消息分组" Foreground="#1E293B" FontSize="14" FontWeight="SemiBold" />
                                <TextBox Text="{Binding MessageGroup, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource InputTextBoxStyle}" />
                                <TextBlock Margin="0,6,0,0" Text="相同分组的通知会在 Bark 历史记录中归集显示。" Foreground="#94A3B8" FontSize="12" />

                                <Border Height="1" Margin="0,24,0,20" Background="#E2E8F0" />

                                <Grid Margin="0,0,0,18">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="持续响铃" Foreground="#1E293B" FontSize="14" FontWeight="SemiBold" />
                                        <TextBlock Margin="0,5,20,0" Text="通知铃声持续播放约 30 秒，需要 Bark 客户端支持。" Foreground="#94A3B8" FontSize="12" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" IsChecked="{Binding ContinuousRinging}" Style="{StaticResource SwitchStyle}" />
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="重要警告" Foreground="#1E293B" FontSize="14" FontWeight="SemiBold" />
                                        <TextBlock Margin="0,5,20,0" Text="使用 critical 级别，可突破静音与勿扰模式；需在 iOS 中授权。" Foreground="#94A3B8" FontSize="12" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" IsChecked="{Binding CriticalAlert}" Style="{StaticResource SwitchStyle}" />
                                </Grid>

                                <Border Margin="0,24,0,0"
                                        Padding="20"
                                        Background="#F8FAFC"
                                        BorderBrush="#E2E8F0"
                                        BorderThickness="1"
                                        CornerRadius="12">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="Windows 后台服务" Foreground="#1E293B" FontSize="14" FontWeight="SemiBold" />
                                                <TextBlock Margin="0,5,20,0"
                                                           Text="以 LocalSystem 自动运行，无需用户登录即可持续监控。"
                                                           Foreground="#94A3B8"
                                                           FontSize="12"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                            <Border Grid.Column="1" Padding="11,6" Background="White" CornerRadius="14">
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="8" Height="8" Margin="0,0,7,0" Fill="{Binding WindowsServiceAccentBrush}" />
                                                    <TextBlock Text="{Binding WindowsServiceStatusText}"
                                                               Foreground="{Binding WindowsServiceAccentBrush}"
                                                               FontSize="12"
                                                               FontWeight="SemiBold" />
                                                </StackPanel>
                                            </Border>
                                        </Grid>

                                        <Grid Grid.Row="1" Margin="0,17,0,0">
                                            <TextBlock Margin="0,0,300,0"
                                                       VerticalAlignment="Center"
                                                       Text="{Binding WindowsServiceDescription}"
                                                       Foreground="#64748B"
                                                       FontSize="12"
                                                       TextWrapping="Wrap" />
                                            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                                <Button Margin="0,0,8,0"
                                                        Content="刷新"
                                                        Command="{Binding RefreshServiceStatusCommand}"
                                                        Style="{StaticResource SecondaryButtonStyle}" />
                                                <Button Margin="0,0,8,0"
                                                        Content="卸载服务"
                                                        Command="{Binding UninstallServiceCommand}"
                                                        Style="{StaticResource SecondaryButtonStyle}" />
                                                <Button Content="安装服务"
                                                        Command="{Binding InstallServiceCommand}"
                                                        Style="{StaticResource PrimaryButtonStyle}" />
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </Border>

                                <Border Height="1" Margin="0,24,0,18" Background="#E2E8F0" />

                                <Grid>
                                    <TextBlock VerticalAlignment="Center" Text="{Binding OperationMessage}" Foreground="#64748B" FontSize="12" TextWrapping="Wrap" Margin="0,0,260,0" />
                                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                        <Button Margin="0,0,10,0" Content="发送测试" Command="{Binding TestNotificationCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                                        <Button Content="保存设置" Command="{Binding SaveSettingsCommand}" Style="{StaticResource PrimaryButtonStyle}" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Window>
