<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.17763.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app-icon.ico</ApplicationIcon>
    <AssemblyName>UPSPowerMonitor</AssemblyName>
    <RootNamespace>UPSPowerMonitor</RootNamespace>
    <Version>1.1.0</Version>
    <Product>UPS Power Monitor</Product>
    <Description>面向 Windows Server 的 UPS 电源监控与 Bark 远程告警工具</Description>
    <Authors>MicroGalaxy</Authors>
    <RepositoryUrl>https://github.com/MicroGalaxy/UPSPowerMonitor</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\app-icon.ico" />
    <Resource Include="Assets\app-icon.png" />
    <Compile Remove="Models\**\*.cs" />
    <Compile Remove="Services\**\*.cs" />
    <Compile Remove="UPSPowerMonitor.Core\**\*.cs" />
    <Compile Remove="UPSPowerMonitor.Service\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="UPSPowerMonitor.Core\UPSPowerMonitor.Core.csproj" />
    <ProjectReference Include="UPSPowerMonitor.Service\UPSPowerMonitor.Service.csproj"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <Target Name="PublishWindowsService" AfterTargets="Publish">
    <MSBuild Projects="UPSPowerMonitor.Service\UPSPowerMonitor.Service.csproj"
             Targets="Publish"
             Properties="Configuration=$(Configuration);RuntimeIdentifier=$(RuntimeIdentifier);SelfContained=$(SelfContained);PublishSingleFile=true;PublishDir=$(PublishDir)" />
  </Target>

</Project>
